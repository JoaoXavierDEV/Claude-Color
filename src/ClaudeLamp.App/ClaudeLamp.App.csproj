<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ClaudeLamp</AssemblyName>
    <RootNamespace>ClaudeLamp.App</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeLamp.Core\ClaudeLamp.Core.csproj" />
    <ProjectReference Include="..\ClaudeLamp.Rgb\ClaudeLamp.Rgb.csproj" />
  </ItemGroup>

</Project>
