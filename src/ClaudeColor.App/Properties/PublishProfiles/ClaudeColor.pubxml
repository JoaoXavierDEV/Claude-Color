<?xml version="1.0" encoding="utf-8"?>
<!--
  Um único ClaudeColor.exe com o .NET embutido (não exige o .NET instalado), publicado direto na instalação:
  %USERPROFILE%\.claude-color\bin. Funciona pelo "Publicar" do Visual Studio e pelo terminal:
    dotnet publish src/ClaudeColor.App -p:PublishProfile=ClaudeColor
  Ao publicar na instalação, fecha o app antes (ele devolve as luzes ao modo original), guarda o exe anterior
  como ClaudeColor.exe.bak e reabre pela tarefa agendada "ClaudeColor" (que o roda como administrador).
  Com -o <pasta> (o workflow de release usa -o out), só gera o exe nessa pasta: nada é fechado nem reaberto.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <ClaudeColorInstallDir>$(USERPROFILE)\.claude-color\bin\</ClaudeColorInstallDir>
    <PublishDir>$(ClaudeColorInstallDir)</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WinForms não suporta trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <_ClaudeColorInstalling Condition="'$([System.IO.Path]::GetFullPath($(PublishDir)))' == '$([System.IO.Path]::GetFullPath($(ClaudeColorInstallDir)))'">true</_ClaudeColorInstalling>
    <_ClaudeColorExe>$(ClaudeColorInstallDir)ClaudeColor.exe</_ClaudeColorExe>
  </PropertyGroup>

  <!-- O exe em uso não pode ser sobrescrito: fecha o app pelo pipe (até 20 s) e guarda o anterior. -->
  <Target Name="ClaudeColorStopInstalled" BeforeTargets="PrepareForPublish" Condition="'$(_ClaudeColorInstalling)' == 'true' And Exists('$(_ClaudeColorExe)')">
    <Message Importance="high" Text="Claude Color: fechando o app instalado (as luzes voltam ao normal)..." />
    <Exec Command="&quot;$(_ClaudeColorExe)&quot; --exit" ContinueOnError="true" />
    <Copy SourceFiles="$(_ClaudeColorExe)" DestinationFiles="$(_ClaudeColorExe).bak" ContinueOnError="true" />
  </Target>

  <Target Name="ClaudeColorStartInstalled" AfterTargets="Publish" Condition="'$(_ClaudeColorInstalling)' == 'true'">
    <Message Importance="high" Text="Claude Color: reabrindo pela tarefa agendada ClaudeColor..." />
    <Exec Command="schtasks /Run /TN ClaudeColor" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>
</Project>
