<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <AssemblyName>ClaudeColor</AssemblyName>
    <RootNamespace>ClaudeColor.App</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.5.1</Version>
    <Product>Claude Color</Product>
    <AssemblyTitle>Claude Color</AssemblyTitle>
    <Company>João Fernando</Company>
    <Authors>João Fernando</Authors>
    <Copyright>© 2026 João Fernando</Copyright>
    <Description>Sincroniza a cor das luzes com o Claude.</Description>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/JoaoXavierDEV/Claude-Color</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="Assets\logo.ico" LogicalName="logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeColor.Core\ClaudeColor.Core.csproj" />
    <ProjectReference Include="..\ClaudeColor.Rgb\ClaudeColor.Rgb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
